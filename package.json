{
  "name": "surface",
  "private": true,
  "packageManager": "bun@1.2.18",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "bun run --filter '*' test && bun test scripts/",
    "dev:straddle-js": "bun run examples/straddle-js/serve.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/bun": "^1.3.14",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
