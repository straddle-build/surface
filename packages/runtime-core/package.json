{
  "name": "@straddlecom/runtime-core",
  "version": "0.2.0",
  "description": "Internal to Straddle's SDKs, not for direct use. Shared surface runtime: postMessage protocol contract.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/straddle-build/surface.git",
    "directory": "packages/runtime-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./message-bus": "./src/message-bus.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun ../../scripts/publish-manifest.ts assert && bun run build"
  }
}
